# انسخ هذا الملف إلى .env محليًا. لا تضع الأسرار في Git.
MAAL_DATABASE_PATH=maal.db
MAAL_LLM_PROVIDER=deterministic
MAAL_LLM_MODEL=claude-sonnet-4-6
MAAL_LLM_TIMEOUT_SECONDS=60
MAAL_LLM_MAX_RETRIES=2
MAAL_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAAL_API_TOKEN=
MAAL_CONNECTOR_TIMEOUT_SECONDS=30
MAAL_CONNECTOR_MAX_RETRIES=2
MAAL_CONNECTOR_USER_AGENT=Maal-Regulatory-Monitor/2.0 (+local compliance demo)
MAAL_REGULATORY_STORAGE_DIR=data/regulatory/raw
MAAL_MAX_REGULATORY_DOCUMENT_BYTES=26214400
ANTHROPIC_API_KEY=
